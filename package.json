{
  "name": "@bpmforge/quarry",
  "version": "0.5.0",
  "description": "Quarry \u2014 agent-grade web retrieval: human-paced multi-engine search + zero-dep fetch\u2192clean-markdown extraction, self-hosted, no third-party scraping API",
  "keywords": [
    "mcp",
    "web-search",
    "web-scraping",
    "readability",
    "markdown",
    "playwright",
    "ai-agents",
    "retrieval"
  ],
  "homepage": "https://github.com/bpmforge/quarry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmforge/quarry.git"
  },
  "bugs": {
    "url": "https://github.com/bpmforge/quarry/issues"
  },
  "type": "module",
  "bin": {
    "quarry": "./dist/cli.js",
    "quarry-mcp": "./dist/mcp.js",
    "bpm-pull": "./dist/cli.js",
    "playwright-search": "./dist/cli.js",
    "playwright-search-mcp": "./dist/mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md",
    "INTEGRATION.md",
    "MCP.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "search": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "mcp:start": "node dist/mcp.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "postinstall": "playwright install chromium || echo \"quarry: Chromium download failed. HTTP engines still work; run 'npx playwright install chromium' for browser fallback.\"",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@types/jsdom": "^28.0.1",
    "jsdom": "^29.1.0",
    "playwright": "^1.49.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
